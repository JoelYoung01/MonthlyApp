  "version": "0.2.0",
  "configurations": [
    {
      "name": "Py: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": ["dev", "api/main.py"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/api/.env",
      "python": "${workspaceFolder}/api/.venv/bin/python",
      "jinja": true
    }
  ]
}
