    "clsx": "^2.1.1",
    "pinia": "^2.1.7",
    "reka-ui": "^2.10.5",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.3",
